---
const { title = "Michael | Software Developer", eyebrow = "Independent developer" } = Astro.props;
const currentPath = Astro.url.pathname;
const links = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Projects", href: "/projects" },
  { label: "Contact", href: "/contact" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Michael is a self-taught developer building practical, reliable software." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<div class="grain" aria-hidden="true"></div>
		<header class="site-header">
			<a class="brand" href="/" aria-label="Michael home">
				<span class="brand-mark" aria-hidden="true">✳</span>
				<span>Michael<span class="brand-dot">.</span></span>
			</a>
			<nav aria-label="Primary navigation">
				{links.map((link) => (
					<a class:list={{ active: currentPath === link.href }} href={link.href}>{link.label}</a>
				))}
			</nav>
			<a class="availability" href="/contact"><span></span> Available for work</a>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<span>{eyebrow}</span>
			<span>Built with curiosity / 2026</span>
		</footer>
	</body>
</html>

<style is:global>
	:root { font-family: "Space Grotesk", sans-serif; color: #f7f5f2; background: #0b0a0c; font-synthesis: none; }
	* { box-sizing: border-box; }
	body { margin: 0; min-width: 320px; background: #0b0a0c; }
	a { color: inherit; text-decoration: none; }
	.grain { position: fixed; inset: 0; pointer-events: none; opacity: .045; z-index: 10; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E"); }
	.site-header { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; max-width: 1120px; margin: 20px auto 0; padding: 10px 12px 10px 18px; border: 1px solid #262329; border-radius: 999px; background: rgba(24, 22, 26, .86); backdrop-filter: blur(18px); }
	.brand { display: flex; align-items: center; gap: 10px; font-size: 19px; font-weight: 600; letter-spacing: -.04em; }
	.brand-mark { display: grid; place-items: center; width: 29px; height: 29px; border: 1px solid #8c6cff; border-radius: 50%; color: #c9bbff; font-size: 17px; box-shadow: 0 0 18px rgba(117, 82, 255, .5); }
	.brand-dot { color: #8f6dff; }
	nav { display: flex; gap: 4px; margin-left: 80px; }
	nav a { padding: 10px 16px; border-radius: 999px; color: #a7a2aa; font-size: 14px; transition: color .2s, background .2s; }
	nav a:hover, nav a.active { color: #fff; background: #2b2930; }
	.availability { display: flex; align-items: center; gap: 8px; padding: 10px 15px; color: #c3bdc8; font-size: 12px; }
	.availability span { width: 7px; height: 7px; border-radius: 50%; background: #75df9e; box-shadow: 0 0 10px #75df9e; }
	main { overflow: hidden; }
	.site-footer { display: flex; justify-content: space-between; max-width: 1120px; margin: 80px auto 0; padding: 20px 0 28px; border-top: 1px solid #29262c; color: #6e6972; font-size: 12px; }
	.eyebrow { display: inline-flex; align-items: center; gap: 9px; color: #9b82ff; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
	.eyebrow::before { content: ""; width: 24px; height: 1px; background: #8d6cff; }
	.display { margin: 22px 0; font-size: clamp(54px, 8vw, 104px); font-weight: 500; letter-spacing: -.075em; line-height: .94; }
	.display em { color: #a58cff; font-family: "DM Serif Display", serif; font-weight: 400; letter-spacing: -.03em; }
	.muted { color: #9d98a1; line-height: 1.65; }
	.button { display: inline-flex; align-items: center; gap: 13px; padding: 14px 19px; border-radius: 999px; background: #7149ed; color: white; font-size: 14px; font-weight: 600; transition: transform .2s, background .2s; }
	.button:hover { background: #8b68f9; transform: translateY(-2px); }
	.button .arrow { display: grid; place-items: center; width: 23px; height: 23px; border-radius: 50%; background: rgba(255,255,255,.18); }
	@media (max-width: 760px) { .site-header { margin: 12px; padding: 10px 12px; } nav { gap: 0; margin-left: 8px; } nav a { padding: 9px 7px; font-size: 12px; } .availability { display: none; } .site-footer { margin: 55px 20px 0; } }
	@media (max-width: 420px) { .brand > span:last-child { display: none; } nav { margin-left: auto; } nav a { padding-inline: 6px; } }
</style>